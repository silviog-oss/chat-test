# ---------------------------------------------------------------------------
# Frontend environment variables (Vite). Copy this file to `.env`.
# These Firebase values are NOT secret — they identify your project and are
# safe to ship in the browser. Real security is enforced by Firestore rules.
# ---------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=your-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:abcdef

# Base path for GitHub Pages. For a project page use "/<repo-name>/".
# For a user/org root page or custom domain use "/".
VITE_BASE=/cs-chat-assessment/
